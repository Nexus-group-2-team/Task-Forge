# TaskForge — environment template.
# Copy to `.env` and fill in real values. `.env` is gitignored; this file only
# ever carries placeholders, never real secrets.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string (Neon, local Postgres, ...)
DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/taskforge?sslmode=require"

# JWT secrets. REQUIRED in production and must be unique, unpredictable values
# (the app refuses to start on the development defaults there).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="replace-with-a-unique-32+-character-secret"
JWT_REFRESH_SECRET="replace-with-a-different-unique-32+-character-secret"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

# Resend — password reset email delivery
RESEND_API_KEY="re_replace_with_your_resend_api_key"
RESEND_FROM_EMAIL="TaskForge <onboarding@resend.dev>"

# Base URL used to build password reset links
FRONTEND_URL="http://localhost:4000"
